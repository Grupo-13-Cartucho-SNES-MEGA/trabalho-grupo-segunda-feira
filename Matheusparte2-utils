#ifndef UTILS_H
#define UTILS_H

#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <ctype.h>

// Limpa o console a cada troca de menu (cls no Windows, clear no Linux/Mac)
void limparTela() {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}

// Le uma linha inteira (aceita espacos), remove o ENTER e troca ';' por ',' para nao quebrar o CSV
void lerTexto(const char *mensagem, char *destino, int tamanho) {
    printf("%s", mensagem);
    if (fgets(destino, tamanho, stdin) == NULL) {
        exit(0); 
    }
    size_t n = strlen(destino);
    if (n > 0 && destino[n - 1] == '\n') {
        destino[n - 1] = '\0';
    } else {
        int c; 
        while ((c = getchar()) != '\n' && c != EOF);
    }
    for (int i = 0; destino[i] != '\0'; i++) {
        if (destino[i] == ';') destino[i] = ',';
    }
}

// Le um inteiro validando a digitacao (repete ate o usuario digitar um numero valido)
int lerInteiro(const char *mensagem) {
    char buffer[32];
    int valor;
    while (1) {
        lerTexto(mensagem, buffer, sizeof(buffer));
        if (sscanf(buffer, "%d", &valor) == 1) return valor;
        printf("[ERRO] Digite um numero inteiro valido.\n");
    }
}

// Le um real validando a digitacao (aceita 12,50 ou 12.50)
float lerFloat(const char *mensagem) {
    char buffer[32];
    float valor;
    while (1) {
        lerTexto(mensagem, buffer, sizeof(buffer));
        for (int i = 0; buffer[i] != '\0'; i++) {
            if (buffer[i] == ',') buffer[i] = '.';
        }
        if (sscanf(buffer, "%f", &valor) == 1) return valor;
        printf("[ERRO] Digite um numero valido (ex: 12.50).\n");
    }
}

// Pergunta s/n e devolve 1 para sim, 0 para nao
int confirmar(const char *mensagem) {
    char resp[8];
    lerTexto(mensagem, resp, sizeof(resp));
    return (resp[0] == 's' || resp[0] == 'S');
}

void pausar() {
    char lixo[8];
    lerTexto("\nPressione ENTER para continuar...", lixo, sizeof(lixo));
}

// Busca textual SEM diferenciar maiusculas/minusculas, usando strstr da <string.h>
int contemTexto(const char *texto, const char *termo) {
    char a[128], b[128];
    int i;
    for (i = 0; texto[i] != '\0' && i < 127; i++) a[i] = (char)tolower((unsigned char)texto[i]);
    a[i] = '\0';
    for (i = 0; termo[i] != '\0' && i < 127; i++) b[i] = (char)tolower((unsigned char)termo[i]);
    b[i] = '\0';
    return strstr(a, b) != NULL;
}

#endif
